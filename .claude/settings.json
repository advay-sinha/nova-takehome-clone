{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(.venv/Scripts/python.exe .claude/scripts/check_setup.py)",
      "Bash(.venv/Scripts/python.exe .claude/hooks/test_guard.py)",
      "Bash(.venv/Scripts/python.exe -m unittest *)",
      "Bash(.venv/Scripts/python.exe -m pip install *)",
      "Bash(make setup)",
      "Bash(make validate)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
